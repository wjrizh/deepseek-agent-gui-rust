{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "力工Studio-Rust",
  "version": "0.1.0",
  "identifier": "com.ligong.deepseek-agent-gui-rust",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "力工Studio-Rust",
        "width": 1000,
        "height": 720,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#ffffff",
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
